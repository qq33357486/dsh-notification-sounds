{
  "name": "dsh-notification-sounds",
  "description": "Cross-platform waiting-for-user and completion sound notifications for the DeepSeek Harness web UI.",
  "version": "0.1.2",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": { "types": "./lib/types/index.d.ts", "default": "./lib/index.js" },
    "./client": { "types": "./lib/types/client/index.d.ts", "default": "./lib/client.js" },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": ["lib", "cordis.patch.yml", "README.md", "README.zh-CN.md", "CHANGELOG.md", "LICENSE"],
  "license": "MIT",
  "repository": { "type": "git", "url": "git+https://github.com/qq33357486/dsh-notification-sounds.git" },
  "homepage": "https://github.com/qq33357486/dsh-notification-sounds#readme",
  "bugs": { "url": "https://github.com/qq33357486/dsh-notification-sounds/issues" },
  "keywords": ["dsh", "dsh-plugin", "deepseek-harness", "notification", "sound", "audio"],
  "engines": { "node": "^22.19.0 || >=24" },
  "publishConfig": { "access": "public", "provenance": true },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "inject": ["@deepseek-ai/dsh-client-locale", "@deepseek-ai/dsh-client-runtime", "@deepseek-ai/dsh-client-ui-slots"],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-client-locale": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-client-runtime": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-client-ui-settings": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-client-ui-slots": "^0.1.0-rc.6",
    "react": "^18.2.0"
  },
  "dependencies": { "@deepseek-ai/schemastery": "^3.18.1" },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-client-locale": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-client-runtime": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-client-ui-settings": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-client-ui-slots": "^0.1.0-rc.6",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22.20.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "jsdom": "^26.1.0",
    "lightningcss": "^1.28.2",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "tsdown": "^0.22.2",
    "typescript": "^5.7.0",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.8"
  },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('lib',{recursive:true,force:true})\"",
    "embed-audio": "node scripts/embed-audio.mjs",
    "build": "pnpm run clean && pnpm run embed-audio && tsc -p tsconfig.json && tsc -p tsconfig.client.json && tsdown",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.client.json --noEmit",
    "test": "vitest run",
    "check": "pnpm run build && pnpm run typecheck && pnpm run test && pnpm run verify",
    "verify": "node scripts/verify.mjs",
    "prepare": "pnpm run clean && node scripts/embed-audio.mjs && tsdown --config tsdown.prepare.config.ts",
    "prepublishOnly": "pnpm run check"
  }
}
